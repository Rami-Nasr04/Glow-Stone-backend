{
  "name": "glow-stone-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "serverless package",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "build:sharp-layer": "npm install --prefix layers/sharp/nodejs --no-save --no-package-lock --os=linux --cpu=arm64 --libc=glibc sharp@0.35.5"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1140.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "dotenv": "^18.0.4",
    "pg": "^8.23.0",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "serverless": "^4.43.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
